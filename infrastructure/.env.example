# Infrastructure Configuration

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=api_service
POSTGRES_PORT=5432

# Zookeeper Configuration
ZOOKEEPER_PORT=2181

# Kafka Configuration
KAFKA_PORT=9092
KAFKA_PORT_INTERNAL=29092

# Redis Configuration
REDIS_PORT=6379
REDIS_PASSWORD=redis

# Services Configuration

# API Service
API_SERVICE_PORT=3000

# Booking Service
BOOKING_SERVICE_PORT=3001

# Application Configuration

# Environment
NODE_ENV=production

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# API Service Specific Configuration

# Idempotency
IDEMPOTENCY_TTL=86400

# Outbox Pattern
OUTBOX_PROCESSING_INTERVAL_MS=5000
OUTBOX_MAX_RETRIES=3
