# Application Configuration
PORT=3001
NODE_ENV=development
SERVICE_NAME=booking-service

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=booking_service

# Kafka Configuration
KAFKA_BROKERS=kafka:29092
KAFKA_CLIENT_ID=booking-service
KAFKA_GROUP_ID=booking-service-group
KAFKA_CONSUMER_GROUP_ID=booking-service-consumer

# Kafka Topics
KAFKA_TOPIC_BOOKING_CREATED=booking.created
KAFKA_TOPIC_BOOKING_STATUS_UPDATED=booking.status.updated

# Kafka Consumer Configuration
KAFKA_CONSUMER_SESSION_TIMEOUT=30000
KAFKA_CONSUMER_HEARTBEAT_INTERVAL=3000
KAFKA_CONSUMER_MAX_RETRIES=3

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
