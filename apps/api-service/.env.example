# Application Configuration
PORT=3000
NODE_ENV=development
SERVICE_NAME=api-service

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=api_service

# Redis Configuration (для идемпотентности)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis

# Idempotency Configuration
IDEMPOTENCY_TTL=86400

# Kafka Configuration
KAFKA_BROKERS=kafka:29092
KAFKA_CLIENT_ID=api-service
KAFKA_GROUP_ID=api-service-group

# Kafka Topics
KAFKA_TOPIC_BOOKING_STATUS_UPDATED=booking.status.updated
KAFKA_TOPIC_BOOKING_STATUS_UPDATED_FAILED=booking.status.updated.failed

# Kafka Consumer Configuration
KAFKA_CONSUMER_MAX_RETRIES=3
KAFKA_CONSUMER_SESSION_TIMEOUT=30000
KAFKA_CONSUMER_HEARTBEAT_INTERVAL=3000

# Outbox Pattern Configuration
OUTBOX_PROCESSING_INTERVAL_MS=5000
OUTBOX_MAX_RETRIES=3

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
